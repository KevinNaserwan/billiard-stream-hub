    "@nestjs/passport": "^8.2.2",
    "@nestjs/websockets": "^8.4.7",
    "@nestjs/platform-ws": "^8.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.5",
    "ws": "^8.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^16.11.45",
    "@types/passport-jwt": "^3.0.6",
